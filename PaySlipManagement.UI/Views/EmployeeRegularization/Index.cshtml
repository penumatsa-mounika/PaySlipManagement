@model List<PaySlipManagement.UI.Models.EmployeeRegularizationViewModel>

@{
    ViewData["Title"] = "Employee Regularization";
    var currentPage = (int)ViewBag.CurrentPage;
    var totalPages = (int)ViewBag.TotalPages;
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="text-primary">Employee Regularization Requests</h3>
        <button type="button" class="btn btn-secondary" onclick="window.history.back();">
            Back
        </button>
    </div>

    <div class="card">
        <div class="card-body">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Employee Code</th>
                        <th>Entry Date</th>
                        <th>In Time</th>
                        <th>Out Time</th>
                        <th>Working Hours</th>
                        <th>Deviation</th>
                        <th>Regularization Type</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var request in Model)
                        {
                            <tr>
                                <td>@request.Id</td>
                                <td>@request.Emp_Code</td>
                                <td>@request.EntryDate.ToString("yyyy-MM-dd")</td>
                                <td>@request.InTime</td>
                                <td>@request.OutTime</td>
                                <td>@request.WorkingHours</td>
                                <td>@request.DeviationInWorkingHours</td>
                                <td>@request.Regularization</td>
                                <td>@request.Status</td>
                                <td class="action-buttons">
                                    <button class="btn btn-success btn-sm" onclick="approveRequest(@request.Id)">
                                        <i class="bi bi-check"></i>
                                    </button>
                                    <button class="btn btn-danger btn-sm" onclick="cancelRequest(@request.Id)">
                                        <i class="bi bi-x"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center text-muted">
                                <i class="fas fa-info-circle"></i> No regularization requests available
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <div class="d-flex justify-content-center mt-3">
            <nav aria-label="Page navigation">
                <ul class="pagination">
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    }
</div>

<!-- Include SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    function approveRequest(id) {
        Swal.fire({
            title: "Are you sure?",
            text: "Do you want to approve this regularization request?",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Yes, Approve",
            cancelButtonText: "Cancel"
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '@Url.Action("ApproveRequest", "EmployeeRegularization")',
                    type: 'POST',
                    data: {
                        id: id,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function () {
                        Swal.fire("Approved!", "Regularization request has been approved.", "success")
                            .then(() => {
                                window.location.reload();
                            });
                    },
                    error: function () {
                        Swal.fire("Error", "An error occurred while approving the request.", "error");
                    }
                });
            }
        });
    }

    function cancelRequest(id) {
        Swal.fire({
            title: "Are you sure?",
            text: "Do you want to reject this regularization request?",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Yes, Reject",
            cancelButtonText: "Cancel"
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '@Url.Action("CancelRequest", "EmployeeRegularization")',
                    type: 'POST',
                    data: {
                        id: id,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function () {
                        Swal.fire("Rejected!", "Regularization request has been declined.", "success")
                            .then(() => {
                                window.location.reload();
                            });
                    },
                    error: function () {
                        Swal.fire("Error", "An error occurred while rejecting the request.", "error");
                    }
                });
            }
        });
    }
</script>
