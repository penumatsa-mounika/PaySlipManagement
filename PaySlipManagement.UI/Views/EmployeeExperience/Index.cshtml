    <div class="card">
        <div class="card-body">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Employee Code</th>
                        <th>Role Name</th>
                        <th>Company Name</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Responsibility</th>
                        <th>Approval Person</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var skill in Model.Where(s => s.Status == "Pending")) 
                        {
                            <tr>
                                <td>@skill.Id</td>
                                <td>@skill.Emp_Code</td>
                                <td>@skill.Role</td>
                                <td>@skill.CompanyName</td>
                                <td>
                                    @{
                                        if (skill.StartMonth.HasValue && skill.StartYear.HasValue)
                                        {
                                            var startDate = new DateTime(skill.StartYear.Value, skill.StartMonth.Value, 1);
                                            @startDate.ToString("MMMM yyyy")
                                        }
                                        else
                                        {
                                            @:"N/A"
                                        }
                                    }
                                </td>
                                <td>
                                    @{
                                        if (skill.EndMonth.HasValue && skill.EndYear.HasValue)
                                        {
                                            var endDate = new DateTime(skill.EndYear.Value, skill.EndMonth.Value, 1);
                                            @endDate.ToString("MMMM yyyy")
                                        }
                                        else
                                        {
                                            @:"Present"
                                        }
                                    }
                                </td>
                                <td>@skill.Responsibility</td>
                                <td>@skill.ApprovalPerson</td>
                                <td>@skill.Status</td>
                                <td class="action-buttons">
                                    <button class="btn btn-success btn-sm" onclick="approveSkill(@skill.Id)"><i class="bi bi-check"></i></button>
                                    <button class="btn btn-danger btn-sm" onclick="declineSkill(@skill.Id)"><i class="bi bi-x"></i></button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center">No pending skill requests available</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>



    <!-- Pagination Controls -->
    @if (totalPages > 1)
    {
        <nav>
            <ul class="pagination justify-content-center mt-4">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)">Previous</a>
                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                    </li>
                }

                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>

<!-- Include SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    function approveSkill(id) {
        Swal.fire({
            title: "Are you sure?",
            text: "Do you want to approve this skill request?",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Yes, approve it!",
            cancelButtonText: "Cancel"
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '@Url.Action("ApproveRequest", "EmployeeExperience")',
                    type: 'POST',
                    data: {
                        id: id,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (response) {
                        Swal.fire("Approved!", "Skill request has been approved.", "success")
                            .then(() => {
                                window.location.reload();
                            });
                    },
                    error: function () {
                        Swal.fire("Error", "An error occurred while approving the skill request.", "error");
                    }
                });
            }
        });
    }

    function declineSkill(id) {
        Swal.fire({
            title: "Are you sure?",
            text: "Do you want to decline this skill request?",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Yes, decline it!",
            cancelButtonText: "Cancel"
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '@Url.Action("CancelRequest", "EmployeeExperience")',
                    type: 'POST',
                    data: {
                        id: id,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (response) {
                        Swal.fire("Declined!", "Skill request has been declined.", "success")
                            .then(() => {
                                window.location.reload();
                            });
                    },
                    error: function () {
                        Swal.fire("Error", "An error occurred while declining the skill request.", "error");
                    }
                });
            }
        });
    }
</script>
<!-- Include SweetAlert -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

