@model DepartmentViewModel

@{
    ViewData["Title"] = "Create";
}
<h1 class="form-heading">Create New Department</h1>

<hr class="custom-hr" />

<div class="container form-container">
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create" method="post">
                <div class="form-group">
                    <label asp-for="DepartmentName" class="form-label"></label>
                    <input asp-for="DepartmentName" class="form-control input-field" />
                    <span asp-validation-for="DepartmentName" class="text-danger"></span>
                </div>

                <!-- ✅ Move the buttons inside the form -->
                <div class="mt-4 button-group">
                    <button type="submit" class="btn btn-primary btn-custom">Create</button>
                    <a asp-action="Index" class="btn btn-secondary btn-custom">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
