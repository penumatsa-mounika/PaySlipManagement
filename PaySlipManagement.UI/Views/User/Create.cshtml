            @model UsersViewModel

@{
    ViewData["Title"] = "Create";
}
<h1 class="form-heading">Create New User</h1>
<hr class="custom-hr" />

<div class="container form-container">
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create" method="post">
                <div class="form-group">
                    <label asp-for="Emp_Code" class="form-label"></label>
                    <input asp-for="Emp_Code" class="form-control input-field" placeholder="Enter Employee Code" />
                    <span asp-validation-for="Emp_Code" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control input-field" placeholder="Enter Email Address" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" type="password" class="form-control input-field" placeholder="Enter Password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="mt-4 button-group">
                    <button type="submit" class="btn btn-primary btn-custom">Create</button>
                    <a asp-action="Index" class="btn btn-secondary btn-custom">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}

<style>
    .form-heading {
        font-size: 1.8rem;
        color: #5dcaff;
        font-weight: 500;
        text-align: center;
        margin-bottom: 20px;
    }

    .custom-hr {
        border: 0;
        height: 2px;
        background: #ffa726;
        margin-bottom: 20px;
    }

    .form-container {
        max-width: 900px;
        margin: 0 auto;
        padding: 20px;
        background-color: #f9f9f9;
        border-radius: 12px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .form-label {
        font-size: 0.9rem;
        font-weight: 500;
        color: #444;
        margin-bottom: 5px;
    }

    .input-field {
        border-radius: 8px;
        padding: 10px;
        font-size: 1rem;
        border: 1px solid #ccc;
        width: 100%;
        transition: border-color 0.3s;
    }

        .input-field:focus {
            border-color: #5dcaff;
            outline: none;
            box-shadow: 0 0 4px rgba(93, 202, 255, 0.5);
        }

    .button-group {
        display: flex;
        justify-content: flex-start;
        gap: 10px;
    }

    .btn-custom {
        border-radius: 8px;
        padding: 10px 20px;
        font-size: 1rem;
        font-weight: 500;
        transition: background-color 0.3s;
    }

        .btn-custom:hover {
            background-color: #007bff;
            color: #fff;
        }

    .btn-secondary {
        background-color: #6c757d;
        color: #fff;
    }

        .btn-secondary:hover {
            background-color: #5a6268;
        }
</style>
